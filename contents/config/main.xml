<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- provider/host/user of the account the popup shows, e.g. github/github.com/addin -->
    <entry name="activeAccount" type="String">
      <default></default>
    </entry>
    <!-- Repos opened from the widget, newest first: "provider/host/user<TAB>owner/repo" -->
    <entry name="recent" type="StringList">
      <default></default>
    </entry>
    <!-- Order of "All repos": pushed (last updated) or name -->
    <entry name="sortBy" type="String">
      <default>pushed</default>
    </entry>
    <entry name="sortDescending" type="Bool">
      <default>true</default>
    </entry>
    <entry name="hideArchived" type="Bool">
      <default>true</default>
    </entry>
    <entry name="includeOrgs" type="Bool">
      <default>true</default>
    </entry>
    <!-- Pinned repos, in pin order: "provider/host/user<TAB>owner/repo" -->
    <entry name="pinned" type="StringList">
      <default></default>
    </entry>
    <!-- Hidden repos: "provider/host/user<TAB>owner/repo" or "...<TAB>owner/group/*" -->
    <entry name="hidden" type="StringList">
      <default></default>
    </entry>
    <!-- Target branch last used per repo: "provider/host/user<TAB>owner/repo<TAB>branch" -->
    <entry name="lastTargets" type="StringList">
      <default></default>
    </entry>
    <!-- Defaults of the merge request form -->
    <entry name="assignToMe" type="Bool">
      <default>true</default>
    </entry>
    <entry name="deleteSourceBranch" type="Bool">
      <default>true</default>
    </entry>
    <entry name="openAfterCreate" type="Bool">
      <default>true</default>
    </entry>
    <!-- Minutes between badge checks while the popup is closed; 0 = no timer, the
         badge is refreshed when the widget loads, the popup opens or repos sync -->
    <entry name="badgeInterval" type="Int">
      <default>0</default>
      <min>0</min>
      <max>240</max>
    </entry>
    <!-- Sync when the popup opens and the list is older than an hour -->
    <entry name="syncOnOpen" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
